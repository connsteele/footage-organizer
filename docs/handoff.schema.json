{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "handoffId": {
      "type": "string",
      "allOf": [
        {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
        },
        {
          "pattern": "^(?!(?:con|prn|aux|nul|com[0-9]|lpt[0-9])$)"
        }
      ]
    },
    "projectId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
    },
    "batchId": {
      "type": "string",
      "allOf": [
        {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
        },
        {
          "pattern": "^(?!(?:con|prn|aux|nul|com[0-9]|lpt[0-9])$)"
        }
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "reviewNotes": {
      "default": "",
      "type": "string",
      "maxLength": 64000
    },
    "reviewFolder": {
      "type": "string",
      "maxLength": 1800
    },
    "folders": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1500
      }
    },
    "clips": {
      "minItems": 1,
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "source": {
            "type": "object",
            "properties": {
              "relativePath": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1800
              },
              "size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "mtimeMs": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "relativePath"
            ]
          },
          "duration": {
            "default": null,
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "markers": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "seconds": {
                  "type": "number",
                  "minimum": 0
                },
                "label": {
                  "type": "string",
                  "maxLength": 4000
                }
              },
              "required": [
                "seconds",
                "label"
              ]
            }
          },
          "proposed": {
            "type": "object",
            "properties": {
              "filename": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "folder": {
                "type": "string",
                "maxLength": 1500
              }
            },
            "required": [
              "filename",
              "folder"
            ]
          },
          "rationale": {
            "default": "",
            "type": "string",
            "maxLength": 16000
          },
          "questions": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 4000
            }
          },
          "hold": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "source",
          "proposed"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "handoffId",
    "projectId",
    "batchId",
    "title",
    "createdAt",
    "clips"
  ]
}
