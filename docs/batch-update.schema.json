{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "batch-update"
    },
    "updateId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
    },
    "requestId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
    },
    "batchId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "reviewNotes": {
      "default": "",
      "type": "string",
      "maxLength": 64000
    },
    "clips": {
      "minItems": 1,
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "proposed": {
            "type": "object",
            "properties": {
              "filename": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "folder": {
                "type": "string",
                "maxLength": 1500
              }
            },
            "required": ["filename", "folder"],
            "additionalProperties": false
          },
          "rationale": {
            "type": "string",
            "maxLength": 16000
          },
          "questions": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 4000
            }
          },
          "markerProposals": {
            "type": "object",
            "properties": {
              "schemaVersion": {
                "type": "number",
                "const": 1
              },
              "items": {
                "maxItems": 10000,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "markerId": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
                    },
                    "originalLabel": {
                      "type": "string",
                      "maxLength": 4000
                    },
                    "seconds": {
                      "type": "number",
                      "minimum": 0
                    },
                    "proposedLabel": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4000
                    },
                    "rationale": {
                      "default": "",
                      "type": "string",
                      "maxLength": 4000
                    }
                  },
                  "required": ["markerId", "originalLabel", "seconds", "proposedLabel"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["schemaVersion", "items"],
            "additionalProperties": false
          }
        },
        "required": ["id", "proposed", "rationale"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "updateId",
    "requestId",
    "projectId",
    "batchId",
    "createdAt",
    "clips"
  ],
  "additionalProperties": false
}
