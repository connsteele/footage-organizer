{
  "name": "footage-organizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client \"tsx watch src/server/index.ts\" \"vite --host 127.0.0.1\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "stop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/stop.ps1 -Quiet",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write src tests scripts docs *.json *.ts *.js *.md",
    "demo": "tsx scripts/create-demo.ts",
    "schema": "tsx scripts/export-schema.ts",
    "validate:handoff": "tsx scripts/validate-handoff.ts",
    "convert:legacy": "tsx scripts/convert-legacy.ts",
    "launch": "node scripts/launch.mjs",
    "shortcut": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-shortcut.ps1"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.8.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.11"
  }
}
